# Agnes AI (chat + drafting completions). Get a key from https://platform.agnes-ai.com/
AGNES_API_KEY=
# Optional overrides — defaults shown below.
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-2.5-flash
# AGNES_FALLBACK_MODEL=agnes-2.0-flash

# OpenAI (embeddings, and the last-resort chat fallback if Agnes is unavailable).
# Get a key from https://platform.openai.com/
OPENAI_API_KEY=
# Optional overrides — defaults shown below.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SQLite database location. Relative paths are resolved under the project's
# `data/` directory; use an absolute path (e.g. a mounted disk) in production.
# DATABASE_URL=./data/legal.db

# Number of chunks to retrieve per RAG query.
# RAG_TOP_K=5
